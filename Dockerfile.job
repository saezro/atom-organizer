# Cloud Run Job del pipeline de ATOM Organizer: organiza un vuelo sin ventana.
#
# Ejecuta el MISMO código que la app de escritorio (`atom_core.organize.run_task`
# vía organize_cli.py), no una reimplementación: si el contenedor y el PC dan
# resultados distintos es un bug, no una diferencia esperada.
#
# Contexto de build = la raíz del repo, porque el pipeline necesita el árbol
# entero (atom_core/, pipeline/, exif/, utils.py) más las .so del SDK DJI.
# Bookworm CLAVADO, no `slim` a secas: el tag flotante ya apunta a Debian 13 y
# ahí varias de estas libs cambiaron de nombre (transición t64: libglib2.0-0 →
# libglib2.0-0t64). Subir de Debian es una decisión aparte, no algo que deba
# pasar solo porque hoy toca reconstruir.
FROM python:3.11-slim-bookworm

# exiftool y ffmpeg se invocan por nombre en Linux (external_tools.resolve_tool):
# no van empaquetados como en Windows, se esperan en el PATH del sistema.
# libexpat/libgl los pide pyexiv2; sin ellos el import peta en runtime, no al build.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libimage-exiftool-perl \
        ffmpeg \
        libexpat1 \
        libgl1 \
        libglib2.0-0 \
        libegl1 \
        libxkbcommon0 \
        libdbus-1-3 \
        libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Las dependencias primero y en su propia capa: el árbol de código cambia en cada
# commit y la lista de deps casi nunca, así que así el rebuild normal no vuelve a
# compilar pandas/numpy.
COPY requirements-server.txt ./
RUN pip install --no-cache-dir -r requirements-server.txt

COPY atom_core/ ./atom_core/
COPY qt_designer_files/ ./qt_designer_files/
COPY config/ ./config/
# pipeline.py y exif.py son módulos sueltos en la raíz, no paquetes. gui.py entra
# porque organize.py saca de él las fases (ver requirements-server.txt).
COPY organize_cli.py external_tools.py utils.py version.py dji_irp_linux.py \
     pipeline.py exif.py gui.py ./

# Solo la parte Linux del SDK DJI (.so). Los .exe y .dll son ~500 KB de peso
# muerto en una imagen que nunca va a correr en Windows.
COPY programas_externos/DJI/*.so* ./programas_externos/DJI/

# El SDK carga libdirp.so con dlopen por nombre, no por ruta absoluta.
ENV LD_LIBRARY_PATH=/app/programas_externos/DJI

# Sin ventana no hay a quién preguntar: cualquier prompt de Qt/matplotlib sería
# un cuelgue silencioso hasta que Cloud Run mate el job por timeout.
ENV MPLBACKEND=Agg

# Qt sin servidor gráfico: sin esto el import de QtWidgets aborta con
# «could not connect to display» en cuanto el Job arranque.
ENV QT_QPA_PLATFORM=offscreen

# Args (--origen, --destino, --estadillo) los pasa el trigger como
# containerOverrides. Sale 0 si el pipeline terminó y 1 si emitió un error, que
# es lo que mira el Job para decidir si reintentar.
ENTRYPOINT ["python", "organize_cli.py"]
